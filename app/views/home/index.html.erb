<% content_for(:title, t('.title')) %>
<% if @team.present? %>
  <div class='flex-col'>
    <div class="mb-10">
      <h5 class="text-teal-500 mb-5 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"><%= t('.notice') %></h5>
      <p class="text-gray-700 mb-5 text-md font-bold tracking-tight dark:text-white"><%= t('.approved', item: @team.name) %><%= l(@member_request&.updated_at || @team.created_at, format: :short) %></p>
      <h5 class="text-teal-500 mb-5 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"><%= t('.topics') %></h5>
      <div>
        <% if @topics.present? %>
          <%= render 'topics/user_posted_topics_list' %>
          <%= paginate @topics, param_name: 'topics' %>
        <% else %>
          <p class="mb-3 text-gray-900 dark:text-white">
            <%= t('.no_result') %>
          </p>
        <% end %>
      </div>
      <div>
        <h5 class="text-teal-500 mb-5 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"><%= t('.user_works') %></h5>
        <%= render partial: 'articles/user_works' %>
      </div>
    </div>
  </div>
<% elsif @member_request.present? %>
  <div class="grid">
    <p class="flex text-teal-500 mb-5 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"><%= t('.member_request_status') %></p>
    <p class="flex text-gray-700 mb-5 text-md font-bold tracking-tight dark:text-white"><%= t('.member_request_result', item: @member_request.team.name) %><%= t("activerecord.attributes.member_request.approval_status.#{@member_request.approval_status}") %></p>
    <% if @member_request.message_from_approver.present? %>
      <p class="flex text-gray-700 mb-5 text-md font-bold tracking-tight dark:text-white"><%= t('.message_from_approver', item: @member_request.message_from_approver) %></p>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-700 mb-5 text-md font-bold tracking-tight dark:text-white"><%= t('.not_belongs_to_team_yet') %></p>
<% end %>
