<% if @my_articles.present? %>
  <%= render 'articles/search_form', q: @q, url: home_path %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <%= render partial: 'articles/article', collection: @my_articles %>
  </div>
  <%= paginate @my_articles, param_name: 'my_articles' %>
<% else %>
  <p class="mb-3 text-gray-900 dark:text-white">
    <%= t('.no_result') %>
  </p>
<% end %>
