<% content_for(:title, t('.title')) %>
<% if @like_articles.present? %>
  <div class="mx-auto mt-8">
    <%= render 'articles/search_form', q: @q, url: article_likes_articles_path %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <%= render partial: 'article', collection: @like_articles %>
    </div>
    <%= paginate @like_articles %>
  </div>
<% else %>
  <p class="text-gray-700 mb-5 text-md font-bold tracking-tight dark:text-white"><%= t('.no_result') %></p>
<% end %>
