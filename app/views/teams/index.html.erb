<% content_for(:title, t('.title')) %>
<div class='flex-col'>
  <% unless current_user.team.present? %>
    <%= link_to t('.new'), new_team_path, class: "mb-10 text-white bg-teal-400 hover:bg-teal-500 focus:outline-none font-medium rounded-lg text-sm px-8 py-2.5 text-center dark:bg-teal-400 dark:hover:bg-teal-500" %>
  <% end %>
  <div class="mt-8">
    <%= render 'search_form', q: @q, url: teams_path %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% if @teams.present? %>
        <%= render partial: 'teams/team', collection: @teams %>
      <% else %>
        <div class="mb-3 dark:text-white"><%= t('.no_result') %></div>
      <% end %>
    </div>
    <%= paginate @teams %>
  </div>
</div>
