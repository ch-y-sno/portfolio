<header>
  <nav class="bg-white border-gray-200 dark:bg-gray-900">
    <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
      <%= link_to root_path, class: "self-left text-2xl font-semibold whitespace-nowrap dark:text-white", alt: "camera icon" do %>
        <i class="fa-solid fa-camera-retro"></i>
      <% end %>
      <span class="self-left text-2xl font-semibold whitespace-nowrap dark:text-white"><%= t('header.app_name') %></span>
      <%= button_tag onclick: "toggleDarkMode()", class: "p-6 text-2xl text-black dark:text-white" do %>
        <i class="fa-solid fa-moon"></i>
      <% end %>
    </div>
  </div>
</nav>
</header>
